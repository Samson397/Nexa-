# =============================================================================
# NEXA AI Operating System — Environment Variables
# Copy to .env.local and fill in values. Never commit secrets.
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NEXA
# When true (or when Supabase env is missing), route protection is relaxed for local demo
DEMO_MODE=true

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Postgres / Supabase connection string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexa

# Auth providers (configure in Supabase dashboard + these for server flows)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Default AI model routing
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NEXA
WEBAUTHN_ORIGIN=http://localhost:3000

# Integration OAuth (optional — enable per integration)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Desktop companion
DESKTOP_ALLOWED_PATHS=

# Logging
LOG_LEVEL=info
